{
    "configurations": [
        {
            "name": "H7_Debug_App",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/cmake/build/Debug/app.elf"
                }
            ],
            "svdPath": "${workspaceFolder}/cmake/STM32H743.svd",
            "verbose": false
        },
        {
            "name": "H7_Debug_Boot",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/cmake/build/Debug/boot.elf"
                }
            ],
            "svdPath": "${workspaceFolder}/cmake/STM32H743.svd",
            "verbose": false
        }
    ]
}
